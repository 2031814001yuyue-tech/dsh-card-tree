{
  "name": "dsh-card-tree",
  "version": "0.8.2",
  "license": "MIT",
  "type": "module",
  "description": "Explore-style card-tree conversations for the DSH Web UI.",
  "author": "Card Tree contributors",
  "homepage": "https://github.com/2031814001yuyue-tech/dsh-card-tree",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "card-tree",
    "conversation-tree",
    "llm",
    "ui"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2031814001yuyue-tech/dsh-card-tree.git"
  },
  "scripts": {
    "check": "node scripts/verify.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE",
    "INSTALL.md",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/verify.mjs",
    "docs/ARCHITECTURE.md",
    "docs/USAGE.md",
    "docs/TUTORIAL.md",
    "docs/preview.png",
    "scripts/install.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
